digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.6, ranksep=0.4, fontname="Arial Unicode MS", fontsize=20, label="D9 · LMCache 与 Mooncake 的两条完成链（概念时序）", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#E6F4EA", color="#548F73", fontname="Arial Unicode MS", fontsize=14, margin="0.18,0.1"];
  edge [fontname="Arial Unicode MS", fontsize=12, color="#52657A"];
  subgraph cluster_write {
    label="保存新 KV"; fontname="Arial Unicode MS"; color="#9BC9AF";
    w0 [label="GPU 状态已产生\n保留源页与设备依赖"];
    w1 [label="L1 reserve_write → 填充 staging"];
    w2 [label="设备完成后 finish / admission\nL1 数据可读"];
    w3 [label="按策略提交 L2 store\n保留 L1 源对象"];
    w4 [label="native batch_put_from\nStore 分配 → 传输 → 发布"];
    w5 [label="汇总实际 store 结果\n解除此次任务保留"];
    w0 -> w1 -> w2 -> w3 -> w4 -> w5;
  }
  subgraph cluster_read {
    label="恢复已有 KV"; fontname="Arial Unicode MS"; color="#9BB7D4";
    r0 [label="LOOKUP ack：已登记\n还不是最终命中结果"];
    r1 [label="L1 / L2 候选与保护\n规划共同可用范围"];
    r2 [label="L2 → L1 staging\nnative batch_get_into"];
    r3 [label="成功对象 admission + 读保留\n折叠实际可用前缀"];
    r4 [label="RETRIEVE → 目标 GPU pages\n满足布局和设备完成条件"];
    r5 [label="引擎使用可跳过范围\n释放本次读保留"];
    r0 -> r1 -> r2 -> r3 -> r4 -> r5;
  }
  w4 -> r2 [style=dashed, label="同一批对象的后续读取；两次请求可独立发生"];
}
