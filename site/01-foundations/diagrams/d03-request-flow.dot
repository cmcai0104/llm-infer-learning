digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.4, fontname="Arial Unicode MS", fontsize=20, label="D3 · 一次请求：未命中、本地命中与远端命中", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2FF", color="#57799F", fontname="Arial Unicode MS", fontsize=14, margin="0.18,0.1"];
  edge [fontname="Arial Unicode MS", fontsize=12, color="#52657A"];
  input [label="1. 输入处理、路由与排队"];
  match [label="2. 匹配语义与布局\n确定候选前缀", shape=diamond, fillcolor="#FFF3D6"];
  local [label="本地可用\n保留页与引用"];
  remote [label="远端候选\n读保护、目标空间与加载预算"];
  miss [label="未命中 / 不值得加载\n计划重算"];
  load [label="3. 传输、转换、设备依赖"];
  ready [label="加载成功且可安全消费？", shape=diamond, fillcolor="#FFF3D6"];
  safe [label="失败：隔离目标，确认在途操作结束\n再回退 / 重试 / 重算", fillcolor="#FDE9E7", color="#BA665E"];
  run [label="4. 按最终可用范围计算 Prefill\n边界和首 token 处理遵循引擎契约"];
  decode [label="5. 持续 Decode，返回输出"];
  end [label="6. 可选保存 KV；安全释放请求资源"];
  input -> match;
  match -> local [label="本地"];
  match -> remote [label="远端"];
  match -> miss [label="无可用候选"];
  remote -> load -> ready;
  ready -> run [label="是"];
  ready -> safe [label="否"];
  safe -> miss;
  local -> run;
  miss -> run;
  run -> decode -> end;
}
