digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.6, ranksep=0.45, fontname="Arial Unicode MS", fontsize=20, label="D6 · 对象发布、读保护与失败回收（协议模型）", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#E6F4EA", color="#548F73", fontname="Arial Unicode MS", fontsize=14, margin="0.18,0.12"];
  edge [fontname="Arial Unicode MS", fontsize=12, color="#52657A"];
  subgraph cluster_write {
    label="写入路径"; fontname="Arial Unicode MS"; color="#9BC9AF";
    reserve [label="1. 保留目标空间\n尚不可读"];
    fill [label="2. 写入 payload\n保护源 / 目标资源"];
    check [label="3. 检查必需部分是否完整"];
    publish [label="4. 发布可读状态"];
    reserve -> fill -> check -> publish;
  }
  subgraph cluster_read {
    label="读取路径"; fontname="Arial Unicode MS"; color="#9BB7D4";
    lookup [label="5. 查询可读副本\n取得适用的读保护"];
    copy [label="6. 读取 payload\n目标仍不可直接消费"];
    valid [label="7. 验证完成、保护窗口与完整性"];
    consume [label="8. 满足布局与设备依赖后消费"];
    done [label="9. 结束本次保留\n回收另按资格与策略决定"];
    lookup -> copy -> valid -> consume -> done;
  }
  publish -> lookup [style=dashed, label="后续读者发现"];
  bad [label="部分写 / 读失败 / 超时\n拒绝消费；先确认在途工作安全结束\n再解除保留、重试或回退", fillcolor="#FDE9E7", color="#BA665E"];
  fill -> bad [style=dashed, label="失败"];
  valid -> bad [style=dashed, label="验证失败"];
}
