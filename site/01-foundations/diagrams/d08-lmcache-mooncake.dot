digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.55, fontname="Arial Unicode MS", fontsize=20, label="D8 · LMCache MP + Mooncake Store（常见 host L1 路径）", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2FF", color="#57799F", fontname="Arial Unicode MS", fontsize=14, margin="0.18,0.12"];
  edge [fontname="Arial Unicode MS", fontsize=12, color="#52657A"];
  subgraph cluster_engine {
    label="推理引擎"; fontname="Arial Unicode MS"; color="#9BB7D4";
    adapter [label="Scheduler / Worker Connector"];
    gpu [label="GPU KV pages"];
    adapter -> gpu [style=dashed, label="位置与执行依赖"];
  }
  subgraph cluster_lmcache {
    label="LMCache MP 服务与 native 扩展"; fontname="Arial Unicode MS"; color="#9BC9AF";
    modules [label="Lookup / Transfer modules"];
    manager [label="StorageManager\nL1 + Prefetch / Store controller"];
    host [label="host L1\nstaging、resident、读写保留", fillcolor="#E6F4EA"];
    native [label="NativeConnectorL2Adapter\nC++ Mooncake connector / Store Client"];
    modules -> manager [style=dashed];
    manager -> host [style=dashed, label="所有权"];
    manager -> native [style=dashed, label="异步任务 / 结果"];
  }
  master [label="Mooncake Master\n对象目录、位置、lease", fillcolor="#FFF3D6"];
  remote [label="贡献者的远端 segments\npayload / replicas", fillcolor="#E6F4EA"];
  adapter -> modules [style=dashed, label="LOOKUP / STORE / RETRIEVE / 完成"];
  gpu -> host [dir=both, color="#20816B", penwidth=2, label="设备传输；不等于普通 RPC payload"];
  host -> native [dir=both, color="#20816B", penwidth=2, label="buffer 描述"];
  native -> remote [dir=both, color="#20816B", penwidth=2, label="通过 TE 等适用后端读写"];
  native -> master [style=dashed, label="查位置、分配、发布、保护"];
}
